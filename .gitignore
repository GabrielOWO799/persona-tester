# 环境变量（含 DeepSeek API Key，切勿提交到仓库）
.env

# Python 虚拟环境
venv/
__pycache__/
*.pyc

# 测试报告（保留目录结构，报告内容本身可不入库）
data/test_reports/
!data/test_reports/.gitkeep

# 用户聊天历史与“上次活跃人格”（本地运行数据，不入库）
data/chat_history/
!data/chat_history/.gitkeep
data/last_active.json

# IDE / 编辑器
.idea/
.vscode/

# 临时文件
*.log
.DS_Store

# 一键回归测试产物（按人格名生成的基线与报告，本地运行数据，不入库）
.regression_baseline_*.json
regression_report_*.md
.regression_baseline.json
regression_report.md

# pytest 缓存与回归运行产物（data/regression/ 为一键回归的基线与报告）
.pytest_cache/
data/regression/
